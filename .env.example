# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The single admin account (can't be used to register)
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# OneDrive / Microsoft Graph. MOCK_ONEDRIVE=true (or unset Azure vars) keeps bills in Supabase Storage only.
MOCK_ONEDRIVE=true
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
ONEDRIVE_REFRESH_TOKEN=
# Leave empty to create event folders directly in "My files".
ONEDRIVE_ROOT_FOLDER=

# Email notifications (Gmail SMTP + app password). Leave unset to disable.
SMTP_USER=
SMTP_PASS=
# Inbox for admin alerts (defaults to NEXT_PUBLIC_ADMIN_EMAIL)
ADMIN_NOTIFY_EMAIL=
SITE_URL=http://localhost:3000
